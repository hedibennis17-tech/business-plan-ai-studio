// Business Plan AI Studio — Prisma Schema
// Database: PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum PlanStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  COMPLETE
  READY_FOR_GENERATION
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  phone         String?
  passwordHash  String?
  googleId      String?       @unique
  role          Role          @default(USER)
  language      String        @default("fr")
  emailVerified DateTime?
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  businessPlans BusinessPlan[]
  payments      Payment[]
  sessions      Session[]
  accounts      Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BusinessPlan {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String     @default("Mon plan d'affaires")
  status         PlanStatus @default(DRAFT)
  currentStep    Int        @default(1)
  completedSteps Int[]      @default([])

  // Infos de base héritées
  country      String  @default("CA")
  province     String?
  language     String  @default("fr")
  businessType String? // startup, pme, grande-entreprise, travailleur-autonome
  sector       String?
  objective    String? // financement, expansion, acquisition, nouveau-projet
  stage        String? // idee, demarrage, croissance, etabli

  // ── Étape 1 — Profil de l'entreprise ──────────────────────────────────────
  step1Data Json? // { companyName, sector, legalForm, province, city, address, launchDate, isExisting, website }

  // ── Étape 2 — Présentation du projet ──────────────────────────────────────
  step2Data Json? // { description, problem, solution, mission, vision, shortTermGoals, mediumTermGoals, longTermGoals, valueProposition, competitiveAdvantage }

  // ── Étape 3 — Analyse du marché ───────────────────────────────────────────
  step3Data Json? // { industry, marketSize, marketPotential, trends, estimatedDemand, opportunities, risks, sources }

  // ── Étape 4 — Clientèle cible ─────────────────────────────────────────────
  step4Data Json? // { clientType, clientProfile, geographicZone, needs, behaviors, segments, existingClients }

  // ── Étape 5 — Concurrence et positionnement ───────────────────────────────
  step5Data Json? // { directCompetitors, indirectCompetitors, competitorProducts, priceComparison, strengths, weaknesses, differentiation }

  // ── Étape 6 — Marketing et ventes ────────────────────────────────────────
  step6Data Json? // { commercializationStrategy, salesChannels, digitalMarketing, advertising, partnerships, pricingPolicy, salesForecast, acquisitionStrategy }

  // ── Étape 7 — Plan opérationnel et RH ────────────────────────────────────
  step7Data Json? // { dailyOperations, equipments, suppliers, partners, employeeCount, functions, salaries, processes }

  // ── Étape 8 — Investissements et financement ──────────────────────────────
  step8Data Json? // { initialInvestment, equipmentCosts, startupFees, workingCapital, personalFunding, loans, grants, investors, amountSought, confirmedFunding, plannedFunding }

  // ── Étape 9 — Prévisions financières ─────────────────────────────────────
  step9Data Json? // { revenue: [{year, amount}], products: [{name, price, volume}], variableCosts, fixedCosts, salaries, rent, insurance, marketing, adminFees, investments, cashNeeds, year1, year2, year3 }

  // ── Étape 10 — Validation et finalisation ────────────────────────────────
  step10Data Json? // { validatedAt, missingFields, notes }

  // Paiement
  isPaid Boolean   @default(false)
  paidAt DateTime?

  // Fichiers générés
  pdfUrl  String?
  docxUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  businessPlanId        String
  businessPlan          BusinessPlan  @relation(fields: [businessPlanId], references: [id])
  stripeSessionId       String        @unique
  stripePaymentIntentId String?
  amount                Int           // en cents (49900 = 499.00$)
  currency              String        @default("cad")
  status                PaymentStatus @default(PENDING)
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  type      String   // welcome, payment-confirm, reminder-1, reminder-2, reminder-3
  status    String   @default("sent")
  metadata  Json?
  createdAt DateTime @default(now())
}
